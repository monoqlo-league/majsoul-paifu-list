{
  "manifest_version": 3,
  "name": "雀魂 牌譜スタッツ出力 リスト取得版",
  "version": "1.1.0",
  "description": "対局一覧のCSVに載っている牌譜を、間隔をあけて順に取得し、和了・放銃・立直・副露の成績を集計のCSVにする非公式の拡張機能。雀魂で牌譜を開いても取り込まない。",
  "permissions": [
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "https://game.mahjongsoul.com/*",
    "https://mahjongsoul.game.yo-star.com/*",
    "https://game.maj-soul.com/*",
    "https://game.maj-soul.net/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "牌譜スタッツ出力 リスト取得版",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://game.mahjongsoul.com/*",
        "https://mahjongsoul.game.yo-star.com/*",
        "https://game.maj-soul.com/*",
        "https://game.maj-soul.net/*"
      ],
      "js": [
        "src/hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://game.mahjongsoul.com/*",
        "https://mahjongsoul.game.yo-star.com/*",
        "https://game.maj-soul.com/*",
        "https://game.maj-soul.net/*"
      ],
      "js": [
        "src/schema.js",
        "src/fans.js",
        "src/pb.js",
        "src/analyze.js",
        "src/content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
